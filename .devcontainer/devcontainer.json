{
  "name": "MassBank Charts Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/MassBank-charts",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/MassBank-charts,type=bind,Z",
  "runArgs": [
    "--userns=keep-id"
  ],
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": false,
  "containerEnv": {
    "HELM_PLUGINS": "/usr/local/share/helm/plugins"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ],
      "settings": {
        "yaml.schemas": {
          "kubernetes": "*.yaml"
        }
      }
    }
  }
}
